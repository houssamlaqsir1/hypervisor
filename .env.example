# Root environment file — read automatically by `docker compose`.
# Copy to `.env` and fill in. (backend/.env stays separate and holds the
# database credentials; compose loads it directly into the backend.)

# Cesium Ion token for the 3D map. Vite inlines this when the frontend
# image is built, so changing it requires a rebuild of that service:
#   docker compose up --build frontend
VITE_CESIUM_ION_TOKEN=replace_with_your_cesium_ion_token
