# Copy to .env and adjust as needed. All values are optional — the defaults
# match a standard local MediaMTX + backend setup.

# Stream published by Larix into MediaMTX (RTSP re-publish, default port 8554).
# The path must match the Larix stream key.
STREAM_URL=rtsp://127.0.0.1:8554/iphone

# Hypervisor backend.
HYPERVISOR_API=http://127.0.0.1:8080

# Must match a camera registered in the hypervisor (admin → Cameras).
CAMERA_ID=CAM-LIVE-1

# yolov8n (nano) is fastest; yolov8s/m/l are more accurate but slower.
# Point at your own .pt file once you fine-tune on railway data.
YOLO_MODEL=yolov8n.pt

# Detection tuning
MIN_CONFIDENCE=0.55
INFERENCE_FPS=2
POST_COOLDOWN_SEC=4

LOG_LEVEL=INFO
